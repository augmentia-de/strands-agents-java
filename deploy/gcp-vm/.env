# =============================================================================
# Strands Agent — Docker Deployment Configuration
# =============================================================================
# This file is loaded by docker-compose.yml. All variables are optional
# unless marked as REQUIRED. Uncomment and adjust as needed.
# =============================================================================

# ---- LLM / Model: Single-Provider ----
OPENAI_API_KEY=demo
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-oss-120b:free
# LLM_TEMPERATURE=0.7
# LLM_MAX_RETRIES=3

# ---- LLM / Model: Multi-Tier (overrides single-provider) ----
# LLM_DEFAULT_TIER=simple          # simple | advanced | routing
# SIMPLE_PROVIDER=openai           # openai | ollama | openai-compatible
# SIMPLE_MODEL=gpt-4o-mini
# SIMPLE_API_KEY=sk-...
# SIMPLE_BASE_URL=https://api.openai.com/v1
# SIMPLE_OLLAMA_BASE_URL=http://localhost:11434
# ADVANCED_PROVIDER=openai
# ADVANCED_MODEL=gpt-4o
# ADVANCED_API_KEY=sk-...
# ADVANCED_BASE_URL=https://api.openai.com/v1

# ---- Agent ----
# STRANDS_SKILLS_DIR=skills
# STRANDS_SESSION_DIR=.sessions
# STRANDS_LLM_LOG_ENABLED=true
# STRANDS_LLM_LOG_PATH=logs/llm-calls.log
# STRANDS_AGENT_BASH_ALLOW=false
# STRANDS_AGENT_HTTP_ALLOW_PRIVATE=false
# STRANDS_AGENT_WORKSPACE=/work/workspace
# STRANDS_AGENT_TOOLS=de.augmentia.strandsagents.core.tools.CalculatorTool
# STRANDS_SKILLS_SEARCH=false

# ---- MCP ----
# STRANDS_MCP_CONFIG=/work/config/MCP_SERVER_CONFIG.json
# STRANDS_MCP_INGEST=false

# ---- Sessions ----
# STRANDS_SESSION_DIR=/work/.sessions

# ---- Web Search ----
# TAVILY_API_KEY=tvly-...

# ---- Vault (HashiCorp) ----
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=s.your-token-here
# VAULT_MOUNT_PATH=secret

# ---- AES Key Vault (Web-UI) ----
# JSTRANDS_KEY_PATH=/work/.jstrands-keys.json

# ---- A2A Protocol ----
# AGENT_URL=http://localhost:8080

# ---- Chaos Engineering (TESTING ONLY) ----
# RANDOM_TOOL_ERRORS_ENABLED=false
# RANDOM_TOOL_TIMEOUT_PROBABILITY=0.0
# RANDOM_TOOL_EXCEPTION_PROBABILITY=0.0
# RANDOM_TOOL_INVALID_JSON_PROBABILITY=0.0
