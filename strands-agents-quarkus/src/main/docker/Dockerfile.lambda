# ============================================================
# Dockerfile.lambda — AWS Lambda (Container Image)
# ============================================================
# Baut auf dem Native-Image aus Dockerfile.native auf und
# fügt den AWS Lambda Web Adapter hinzu.
#
# Build:
#   docker build -f strands-agents-quarkus/src/main/docker/Dockerfile.native -t strands-agent-native .
#   docker build -f strands-agents-quarkus/src/main/docker/Dockerfile.lambda \
#       --build-arg SSM_EXTENSION_URL=... -t strands-agent-lambda .
#
# Lokal testen:
#   docker run -p 8082:8082 -e VAULT_ADDR=... strands-agent-lambda
# ============================================================
FROM strands-agent-native:latest AS base

USER root

# AWS Parameters & Secrets Lambda Extension (HTTP auf localhost:2773)
ARG SSM_EXTENSION_URL
RUN test -n "$SSM_EXTENSION_URL" && \
    apt-get update && apt-get install -y --no-install-recommends curl ca-certificates unzip && \
    curl -sL "$SSM_EXTENSION_URL" -o /tmp/params-ext.zip && \
    unzip -o /tmp/params-ext.zip -d /opt/ && \
    rm /tmp/params-ext.zip && \
    apt-get purge -y curl ca-certificates unzip && \
    apt-get autoremove --purge -y && \
    rm -rf /var/lib/apt/lists/*

# AWS Lambda Web Adapter (HTTP-konforme Apps auf Lambda)
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.0 /lambda-adapter /opt/extensions/lambda-adapter

ENV READINESS_CHECK_PATH=/q/health/live \
    AWS_LAMBDA_EXEC_WRAPPER=/opt/bootstrap \
    AWS_LWA_PORT=8082 \
    PARAMETERS_SECRETS_EXTENSION_HTTP_PORT=2773

EXPOSE 8082
